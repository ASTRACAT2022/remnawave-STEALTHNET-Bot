# Telemost + VP8 is the recommended initial profile for this node module.
OLCRTC_REF=master
OLCRTC_PROVIDER=telemost
OLCRTC_TRANSPORT=vp8channel

# Create a Telemost room first and put its ID here. The value must be identical
# in BillingStyle and in every client configuration.
OLCRTC_ROOM_ID=REPLACE_WITH_TELEMOST_ROOM_ID

# Generate once: openssl rand -hex 32
OLCRTC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OLCRTC_DNS=8.8.8.8:53

# VP8 payload. Put the matching values into the BillingStyle node payload:
# vp8-fps=25&vp8-batch=1
OLCRTC_VP8_FPS=25
OLCRTC_VP8_BATCH_SIZE=1

# Optional upstream SOCKS5 for the server's outgoing internet connections.
OLCRTC_UPSTREAM_SOCKS_HOST=
OLCRTC_UPSTREAM_SOCKS_PORT=0
OLCRTC_UPSTREAM_SOCKS_USER=
OLCRTC_UPSTREAM_SOCKS_PASS=
OLCRTC_DEBUG=false
