# One per-client OlcRTC server is created by the provisioner after the buyer
# enters their own Telemost or WBStream room in BillingStyle.
OLCRTC_REF=master
OLCRTC_IMAGE=astracat/olcrtc-node:latest
OLCRTC_PROVISIONER_IMAGE=astracat/olcrtc-provisioner:latest

# Small VPS (1–2 vCPU): use 1 to avoid saturating the server while compiling.
# This applies only during docker compose build; runtime containers are not limited.
OLCRTC_BUILD_JOBS=1

# Generate a secret: openssl rand -hex 32
# This is the value copied into the BillingStyle personal node, not to clients.
OLCRTC_PROVISIONER_TOKEN=REPLACE_WITH_A_RANDOM_64_HEX_SECRET

# Use the VPS private IP if BillingStyle is in the same private network.
# If BillingStyle is elsewhere, use 0.0.0.0:9500 and allow only its IP in the
# firewall. Never expose this port to the public Internet.
OLCRTC_PROVISIONER_LISTEN=0.0.0.0:9500
