# WBStream + VP8 works in the normal guest flow.
OLCRTC_REF=master
OLCRTC_PROVIDER=wbstream
OLCRTC_TRANSPORT=vp8channel

# Create a WBStream room first and put its ID here.
OLCRTC_ROOM_ID=REPLACE_WITH_WBSTREAM_ROOM_ID

# Generate once: openssl rand -hex 32
OLCRTC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OLCRTC_DNS=8.8.8.8:53

# Optional. Leave empty for guest mode. It is required only if you switch to
# datachannel and the token grants canPublishData/moderator rights.
OLCRTC_WBSTREAM_TOKEN=

# Put the matching values into the BillingStyle node payload:
# vp8-fps=30&vp8-batch=64
OLCRTC_VP8_FPS=30
OLCRTC_VP8_BATCH_SIZE=64

OLCRTC_UPSTREAM_SOCKS_HOST=
OLCRTC_UPSTREAM_SOCKS_PORT=0
OLCRTC_UPSTREAM_SOCKS_USER=
OLCRTC_UPSTREAM_SOCKS_PASS=
OLCRTC_DEBUG=false
